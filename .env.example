# ==============================================================================
# OpenDataLens SaaS — Environment Configuration Reference
# ==============================================================================

# Server Environment & Network
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=https://opendatalens-app.vercel.app

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://opendatalens.onrender.com/api

# Security & Session Integrity (HMAC-SHA256 Token Signing)
# If left unset, server auto-generates a secure 32-byte secret on boot
SESSION_SECRET=your_cryptographically_secure_random_session_secret_32_bytes

# Admin Telemetry & Metrics Security (Phase 7.2)
# Required to access /api/admin/telemetry and the /admin dashboard.
# If unset, admin telemetry is safely disabled (returns HTTP 503). Never use default passwords.
OPENDATALENS_ADMIN_KEY=your_secure_admin_key_here

# Telemetry Protection Thresholds (Render 512 MB Container)
TELEMETRY_MEM_WARNING_MB=350.0
TELEMETRY_MEM_CRITICAL_MB=450.0
TELEMETRY_LATENCY_BUFFER_SIZE=500

# Optional External APM & Observability Providers (Dormant unless configured)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Storage Limits & Settings
MAX_UPLOAD_SIZE_MB=25
SESSION_TTL_HOURS=24
